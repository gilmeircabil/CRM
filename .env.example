PORT=5000
NODE_ENV=development
# MongoDB connection string (local mongod or Atlas URI)
# If local mongod is not running, server can seamlessly fall back to an in-memory MongoDB for local zero-config evaluation.
MONGODB_URI=mongodb://localhost:27017/clientflow
SESSION_SECRET=clientflow-prototype-session-secret-change-in-production-12345
ADMIN_EMAIL=admin@clientflow.com
ADMIN_PASSWORD=AdminPassword123!
# Optional secret key required to register administrator accounts via the /register UI
ADMIN_REGISTRATION_KEY=
